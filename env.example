# Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql://vulnsphere:prime@localhost:5432/vulnsphere
REDIS_URL=redis://localhost:6379
TIMESCALE_URL=postgresql://vulnsphere:prime@localhost:5433/timeseries

# ZKAEDI PRIME Parameters
FRACTAL_ALPHA=0.618
ETA=0.4
GAMMA=0.3
BETA=0.1
SIGMA=0.05
PHI=1.618

# Security Scanners
TRIVY_PATH=/usr/local/bin/trivy
ZAP_API_KEY=your-zap-api-key
NMAP_OPTS=-sV --script=vuln

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
